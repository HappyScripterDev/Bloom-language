fn total(view: Slice<int>) -> int {
    var sum = 0;
    var i = 0;
    while i < len(view) {
        sum = sum + view[i];
        i = i + 1;
    }
    return sum;
}

fn main() -> int {
    var values = [10, 20, 30, 40, 50];

    let middle = slice_view(values, 1, 4);
    println(len(middle));
    println(total(middle));

    // Änderungen am Array sind über den View sichtbar.
    values[2] = 99;
    println(middle[1]);

    // Änderungen über den View wirken auf das Array.
    var writable = slice_view(values, 0, 3);
    writable[0] = 7;
    println(values[0]);

    // Der View bleibt gültig, wenn das Array wächst (Reallokation).
    var grow = [1, 2, 3];
    let stable = slice_view(grow, 0, 2);
    var i = 0;
    while i < 40 {
        push(grow, i);
        i = i + 1;
    }
    println(stable[0]);
    println(stable[1]);
    println(len(stable));

    // Der View hält den Header am Leben, auch ohne Array-Variable.
    let detached = slice_view([100, 200, 300], 1, 3);
    println(detached[0]);
    println(detached[1]);

    // Kopie von `slice` bleibt eine eigenständige Kopie.
    let copy = slice(values, 0, 3);
    values[0] = 0;
    println(copy[0]);

    return 0;
}
