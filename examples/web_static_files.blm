// Statische Dateien ausliefern (std::web::static_file).
// Legt einen kleinen Webserver-Ordner an, gibt den Port aus und beantwortet
// 10 Anfragen. Content-Type kommt aus der Endung, unbekannte Endungen
// werden als application/octet-stream gesendet; HEAD liefert nur die
// Kopfzeilen. Pfade ausserhalb des Wurzelordners werden abgelehnt.
use std::web;
use std::http;
use std::net;
use std::fs;

fn ok_int(r: Result<int, string>) -> int {
    return match r {
        Result::Ok(v) => v,
        Result::Err(e) => -1
    };
}

fn write_demo_file(path: string, text: string) -> void {
    match fs::write_text(path, text) {
        Result::Ok(_) => println("Datei: " + path),
        Result::Err(e) => println("FEHLER: " + e)
    };
}

fn setup(dir: string) -> void {
    match fs::create_dir_all(fs::join_path(dir, "sub")) {
        Result::Ok(_) => println("Verzeichnis bereit"),
        Result::Err(e) => println("FEHLER: " + e)
    };
    write_demo_file(
        fs::join_path(dir, "index.html"),
        "<!doctype html><html><head><link rel=\"stylesheet\" href=\"/style.css\"></head>" +
        "<body><h1>Statische Dateien</h1><script src=\"/sub/app.js\"></script></body></html>"
    );
    write_demo_file(fs::join_path(dir, "style.css"), "body { font-family: sans-serif; }");
    write_demo_file(fs::join_path(dir, "sub/app.js"), "console.log('hallo');");
    write_demo_file(fs::join_path(dir, "data.json"), "{\"ok\":true}");
    write_demo_file(fs::join_path(dir, "notes.txt"), "einfacher Text");
}

fn cleanup(dir: string) -> void {
    fs::remove_file(fs::join_path(dir, "index.html"));
    fs::remove_file(fs::join_path(dir, "style.css"));
    fs::remove_file(fs::join_path(dir, "sub/app.js"));
    fs::remove_file(fs::join_path(dir, "data.json"));
    fs::remove_file(fs::join_path(dir, "notes.txt"));
    fs::remove_dir(fs::join_path(dir, "sub"));
    fs::remove_dir(dir);
}

fn serve(conn: int, request: http::HttpRequest) -> void {
    match web::static_file(conn, "bloom_static_demo", request) {
        Result::Ok(status) => println("gesendet: " + str(status)),
        Result::Err(e) => println("Schreibfehler: " + e)
    };
    net::tcp_close(conn);
}

fn read_failed(conn: int, e: string) -> void {
    println("Lesefehler: " + e);
    net::tcp_close(conn);
}

fn handle(conn: int) -> void {
    match http::read_request(conn) {
        Result::Ok(request) => serve(conn, request),
        Result::Err(e) => read_failed(conn, e)
    };
}

fn accept_next(listener: int) -> void {
    match net::tcp_accept(listener) {
        Result::Ok(conn) => handle(conn),
        Result::Err(e) => println("accept: " + e)
    };
}

fn main() -> int {
    let dir = "bloom_static_demo";
    setup(dir);
    let listener = ok_int(net::tcp_listen("127.0.0.1", 0, 8));
    if listener < 0 {
        println("listen fehlgeschlagen");
        cleanup(dir);
        return 1;
    }
    println(ok_int(net::local_port(listener)));
    println("Statische Dateien aus " + dir);
    var i = 0;
    while i < 10 {
        accept_next(listener);
        i = i + 1;
    }
    net::tcp_close(listener);
    cleanup(dir);
    return 0;
}
