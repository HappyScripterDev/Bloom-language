// Resize: beim Veraendern der Fenstergroesse berechnet das Layout neu.
// Ein Klick auf "Groesse" zeigt Clientgroesse und Textarea-Grenzen.
use std::desktop;

fn on_event(win: desktop::Window, ev: desktop::Event, status: int) -> bool {
    if ev.kind == "click" {
        match desktop::window_client_size(win) {
            Result::Ok(s) => report(win, status, s),
            Result::Err(e) => println("Groesse: " + e)
        };
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn report(win: desktop::Window, status: int, size: desktop::Size) -> void {
    match desktop::control_bounds(win, 101) {
        Result::Ok(b) => set(
            win,
            status,
            "Client " + str(size.width) + "x" + str(size.height)
                + " / Text " + str(b.width) + "x" + str(b.height)
        ),
        Result::Err(e) => println("Grenzen: " + e)
    };
}

fn set(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn step(win: desktop::Window, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn build(win: desktop::Window) -> Result<int, string> {
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 10)?;
    desktop::layout_set_spacing(win, root, 6)?;
    let head = desktop::label_create(win, "Ziehe die Fenstergroesse.", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, head, desktop::LayoutItem {
        flex: 0, width: 0, height: 24, align: ""
    })?;
    let area = desktop::text_area_create(win, "Mehrzeiliger Text", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, area, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: ""
    })?;
    let row = desktop::layout_create(win, "row")?;
    let button = desktop::button_create(win, "Groesse", 0, 0, 10, 10)?;
    let status = desktop::label_create(win, "", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, row, button, desktop::LayoutItem {
        flex: 0, width: 120, height: 32, align: ""
    })?;
    desktop::layout_add_control(win, row, status, desktop::LayoutItem {
        flex: 1, width: 0, height: 32, align: ""
    })?;
    desktop::layout_add_layout(win, root, row, desktop::LayoutItem {
        flex: 0, width: 0, height: 32, align: ""
    })?;
    desktop::layout_attach(win, root)?;
    return Result::Ok(status);
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Resize", 520, 360)?;
    let status = build(win)?;
    desktop::window_show(win)?;
    while step(win, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
