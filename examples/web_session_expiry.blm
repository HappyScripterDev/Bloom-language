// Sessions mit begrenzter Lebensdauer (absolute TTL, monotone Uhr).
// Der Store läuft nach 1 Sekunde ab; danach gilt der Cookie als unbekannt.
// Nach 4 Anfragen beendet sich der Server.
use std::web;
use std::http;
use std::json;
use std::html;
use std::net;

fn resumed_text(resumed: bool) -> string {
    if resumed {
        return "wiederverwendet";
    }
    return "neu";
}

fn send_page(conn: int, tmpl: html::Template, session: web::Session, resumed: bool, headers: string) -> void {
    let data = json::make_object();
    json::set(data, "state", json::make_string(resumed_text(resumed)));
    json::set(data, "ttl", json::make_int(1));
    match html::render_page_with(conn, 200, tmpl, data, headers) {
        Result::Ok(_) => println("Seite gesendet"),
        Result::Err(e) => println("Renderfehler: " + e)
    };
}

fn with_session(conn: int, tmpl: html::Template, session: web::Session, resumed: bool) -> void {
    match web::session_cookie_insecure(session, "sid", 1) {
        Result::Ok(line) => send_page(conn, tmpl, session, resumed, line),
        Result::Err(e) => println("Cookie-Fehler: " + e)
    };
}

fn new_session(conn: int, store: web::SessionStore, tmpl: html::Template) -> void {
    match web::session_new(store) {
        Result::Ok(session) => with_session(conn, tmpl, session, false),
        Result::Err(e) => println("Session-Fehler: " + e)
    };
}

fn try_resume(conn: int, store: web::SessionStore, tmpl: html::Template, cookies: web::Cookies) -> void {
    match web::session_load(store, cookies, "sid") {
        Result::Ok(session) => with_session(conn, tmpl, session, true),
        Result::Err(e) => new_session(conn, store, tmpl)
    };
}

fn handle(conn: int, store: web::SessionStore, request: http::HttpRequest, tmpl: html::Template) -> void {
    match web::cookies(request) {
        Result::Ok(cookies) => try_resume(conn, store, tmpl, cookies),
        Result::Err(e) => println("Cookie-Fehler: " + e)
    };
}

fn run() -> Result<int, string> {
    let src = "<!doctype html><html><head><meta charset=\"utf-8\"><title>Session-Ablauf</title></head>" + "<body><h1>Session-Ablauf</h1><p>Zustand: {{state}}</p>" + "<p>Lebensdauer: {{ttl}} Sekunde(n)</p></body></html>";
    let tmpl = html::template(src)?;
    let store = web::session_store(8, 1)?;
    let listener = net::tcp_listen("127.0.0.1", 0, 8)?;
    println(net::local_port(listener)?);
    println("Ablauf-Server bereit");
    var i = 0;
    while i < 4 {
        let conn = net::tcp_accept(listener)?;
        match http::read_request(conn) {
            Result::Ok(request) => handle(conn, store, request, tmpl),
            Result::Err(e) => println("Lesefehler: " + e)
        };
        net::tcp_close(conn);
        i = i + 1;
    }
    net::tcp_close(listener);
    return Result::Ok(0);
}

fn fail(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fail(e)
    };
}
