fn main() -> int {
    var counter = 0;

    println("while:");
    while counter < 5 {
        println(counter);
        counter = counter + 1;
    }

    println("for:");
    for i in 0..10 {
        println(i);
    }

    println("break/continue:");
    for i in 0..20 {
        if i % 2 == 0 {
            continue;
        }
        if i > 9 {
            break;
        }
        println(i);
    }

    return 0;
}
