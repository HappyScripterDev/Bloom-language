// Layouts: vertikaler Container mit verschachtelter Zeile und Padding.
// Klicke einen Button, um die berechneten Grenzen auszugeben.
use std::desktop;

fn show(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn on_event(win: desktop::Window, ev: desktop::Event, status: int) -> bool {
    if ev.kind == "click" {
        match desktop::control_bounds(win, 101) {
            Result::Ok(b) => show(
                win,
                status,
                "Button: " + str(b.x) + "," + str(b.y) + " " + str(b.width) + "x" + str(b.height)
            ),
            Result::Err(e) => println("Grenzen: " + e)
        };
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn step(win: desktop::Window, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn build(win: desktop::Window) -> Result<int, string> {
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 12)?;
    desktop::layout_set_spacing(win, root, 8)?;
    let title = desktop::label_create(win, "Layout-Demo", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, title, desktop::LayoutItem {
        flex: 0, width: 0, height: 28, align: ""
    })?;
    let row = desktop::layout_create(win, "row")?;
    let first = desktop::button_create(win, "Erster", 0, 0, 10, 10)?;
    let second = desktop::button_create(win, "Zweiter", 0, 0, 10, 10)?;
    let third = desktop::button_create(win, "Fester Rest", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, row, first, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: ""
    })?;
    desktop::layout_add_control(win, row, second, desktop::LayoutItem {
        flex: 2, width: 0, height: 0, align: ""
    })?;
    desktop::layout_add_control(win, row, third, desktop::LayoutItem {
        flex: 0, width: 120, height: 0, align: "end"
    })?;
    desktop::layout_add_layout(win, root, row, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: ""
    })?;
    let status = desktop::label_create(win, "", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, status, desktop::LayoutItem {
        flex: 0, width: 0, height: 44, align: ""
    })?;
    desktop::layout_attach(win, root)?;
    return Result::Ok(status);
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Layouts", 560, 320)?;
    let status = build(win)?;
    desktop::window_show(win)?;
    while step(win, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
