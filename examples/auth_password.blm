// Passwörter mit Argon2id hashen und prüfen.
// Der Hash enthält Salt und Parameter im PHC-Format.
use std::auth;

fn show_hash(r: Result<string, string>, label: string) -> void {
    match r {
        Result::Ok(hash) => println(label + ": " + hash),
        Result::Err(e) => println(label + " FEHLER: " + e)
    };
}

fn main() -> int {
    match auth::password_hash("ein wirklich langes Passwort") {
        Result::Ok(hash) => check(hash),
        Result::Err(e) => println("Hash-Fehler: " + e)
    };
    match auth::password_verify("egal", "kein-gueltiger-hash") {
        Result::Ok(v) => println("kaputter Hash: UNERWARTET"),
        Result::Err(e) => println("kaputter Hash: " + e)
    };
    show_hash(auth::password_hash("kurz"), "zu kurz");
    return 0;
}

fn check(hash: string) -> void {
    println("Hash: " + hash);
    println("Laenge: " + str(len(hash)));
    match auth::password_verify("ein wirklich langes Passwort", hash) {
        Result::Ok(v) => println("richtig: " + str(v)),
        Result::Err(e) => println("Pruefung fehlgeschlagen: " + e)
    };
    match auth::password_verify("falsches Passwort", hash) {
        Result::Ok(v) => println("falsch: " + str(v)),
        Result::Err(e) => println("Pruefung fehlgeschlagen: " + e)
    };
    match auth::password_needs_rehash(hash) {
        Result::Ok(v) => println("Neu-Hashen noetig: " + str(v)),
        Result::Err(e) => println("Rehash-Fehler: " + e)
    };
}
