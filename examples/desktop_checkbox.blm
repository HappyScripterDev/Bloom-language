// Checkbox: der Zustand wird beim Umschalten gelesen und angezeigt.
use std::desktop;

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn on_event(win: desktop::Window, ev: desktop::Event, status: int) -> bool {
    if ev.kind == "check" {
        match desktop::control_set_text(win, status, "Aktiv: " + str(ev.checked)) {
            Result::Ok(_) => println("Aktiv: " + str(ev.checked)),
            Result::Err(e) => println("Label: " + e)
        };
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn step(win: desktop::Window, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, status),
        Result::Err(e) => fail(e)
    };
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Checkbox", 420, 200)?;
    desktop::label_create(win, "Einstellungen:", 24, 20, 360, 24)?;
    desktop::checkbox_create(win, "Benachrichtigungen aktiv", 24, 56, 280, 26)?;
    let status = desktop::label_create(win, "Aktiv: false", 24, 100, 360, 28)?;
    desktop::window_show(win)?;
    while step(win, status) {
        if ! desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
