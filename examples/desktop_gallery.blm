// Galerie: Menue, Layout, ComboBox, TextArea, ListBox und Statuslabel.
use std::desktop;

fn on_event(
    win: desktop::Window,
    ev: desktop::Event,
    combo: int,
    area: int,
    list: int,
    status: int
) -> bool {
    if ev.kind == "menu" {
        println("menu:" + ev.text);
        if ev.text == "Ende" {
            match desktop::window_close(win) {
                Result::Ok(_) => println("Galerie beendet"),
                Result::Err(e) => println("Schliessen: " + e)
            };
        }
    } else if ev.kind == "select" {
        set(win, status, "Auswahl: " + ev.text);
    } else if ev.kind == "input" {
        set(win, status, "Text: " + str(len(ev.text)) + " Zeichen");
    } else if ev.kind == "click" {
        set(win, status, "Klick: " + str(ev.control));
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn set(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn step(
    win: desktop::Window,
    combo: int,
    area: int,
    list: int,
    status: int
) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, combo, area, list, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Galerie", 620, 460)?;
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 12)?;
    desktop::layout_set_spacing(win, root, 8)?;
    let title = desktop::label_create(win, "Native Steuerelemente", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, title, desktop::LayoutItem {
        flex: 0, width: 0, height: 28, align: ""
    })?;
    let combo = desktop::combo_create(win, "ComboBox A", 0, 0, 10, 10)?;
    desktop::combo_add(win, combo, "ComboBox B")?;
    desktop::combo_add(win, combo, "ComboBox C")?;
    desktop::layout_add_control(win, root, combo, desktop::LayoutItem {
        flex: 0, width: 0, height: 28, align: ""
    })?;
    let area = desktop::text_area_create(win, "Mehrzeiliger\nText", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, area, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: ""
    })?;
    let list = desktop::list_create(win, 0, 0, 10, 10)?;
    desktop::list_add(win, list, "ListBox A")?;
    desktop::list_add(win, list, "ListBox B")?;
    desktop::layout_add_control(win, root, list, desktop::LayoutItem {
        flex: 0, width: 0, height: 80, align: ""
    })?;
    let row = desktop::layout_create(win, "row")?;
    let ok = desktop::button_create(win, "Status", 0, 0, 10, 10)?;
    let quit = desktop::button_create(win, "Ende", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, row, ok, desktop::LayoutItem {
        flex: 1, width: 0, height: 34, align: ""
    })?;
    desktop::layout_add_control(win, row, quit, desktop::LayoutItem {
        flex: 1, width: 0, height: 34, align: ""
    })?;
    desktop::layout_add_layout(win, root, row, desktop::LayoutItem {
        flex: 0, width: 0, height: 34, align: ""
    })?;
    let status = desktop::label_create(win, "", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, status, desktop::LayoutItem {
        flex: 0, width: 0, height: 24, align: ""
    })?;
    desktop::layout_attach(win, root)?;
    desktop::menu_create(win)?;
    let file = desktop::menu_add(win, "Datei")?;
    desktop::menu_item(win, file, "Info")?;
    desktop::menu_item(win, file, "Ende")?;
    desktop::window_show(win)?;
    while step(win, combo, area, list, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
