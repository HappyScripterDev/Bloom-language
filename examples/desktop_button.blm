// Button-Ereignisse: jeder Klick zaehlt hoch und aktualisiert ein Label.
use std::desktop;

var klicks: int = 0;

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn on_event(win: desktop::Window, ev: desktop::Event, status: int) -> bool {
    if ev.kind == "click" {
        klicks = klicks + 1;
        match desktop::control_set_text(win, status, "Klicks: " + str(klicks)) {
            Result::Ok(_) => println("Klick " + str(klicks)),
            Result::Err(e) => println("Label: " + e)
        };
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn step(win: desktop::Window, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, status),
        Result::Err(e) => fail(e)
    };
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Button", 420, 220)?;
    desktop::label_create(win, "Klicke den Button:", 24, 20, 360, 24)?;
    let status = desktop::label_create(win, "Klicks: 0", 24, 52, 360, 28)?;
    desktop::button_create(win, "Klick mich", 24, 100, 160, 36)?;
    desktop::window_show(win)?;
    while step(win, status) {
        if ! desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
