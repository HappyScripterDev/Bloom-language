// ComboBox: Auswahl aus vorgegebenen Eintraegen.
use std::desktop;

fn on_event(win: desktop::Window, ev: desktop::Event, combo: int, status: int) -> bool {
    if ev.kind == "select" {
        report(win, combo, status, "Auswahl");
    } else if ev.kind == "click" {
        report(win, combo, status, "Button");
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn report(win: desktop::Window, combo: int, status: int, quelle: string) -> void {
    match desktop::combo_selected(win, combo) {
        Result::Ok(index) => show(win, status, quelle + ": Index " + str(index)),
        Result::Err(e) => println("Auswahl: " + e)
    };
    match desktop::combo_selected_text(win, combo) {
        Result::Ok(text) => println("Text: " + text),
        Result::Err(e) => println("Text: " + e)
    };
}

fn show(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn step(win: desktop::Window, combo: int, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, combo, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn build(win: desktop::Window) -> Result<int, string> {
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 16)?;
    desktop::layout_set_spacing(win, root, 10)?;
    let combo = desktop::combo_create(win, "Erster Eintrag", 0, 0, 10, 10)?;
    desktop::combo_add(win, combo, "Zweiter Eintrag")?;
    desktop::combo_add(win, combo, "Dritter Eintrag")?;
    desktop::layout_add_control(win, root, combo, desktop::LayoutItem {
        flex: 0, width: 0, height: 28, align: ""
    })?;
    let button = desktop::button_create(win, "Auswahl anzeigen", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, button, desktop::LayoutItem {
        flex: 0, width: 0, height: 34, align: ""
    })?;
    let status = desktop::label_create(win, "Noch keine Auswahl.", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, status, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: "start"
    })?;
    desktop::layout_attach(win, root)?;
    return Result::Ok(status);
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: ComboBox", 460, 240)?;
    let status = build(win)?;
    let combo = 100;
    desktop::window_show(win)?;
    while step(win, combo, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
