// Kleine HTML-Seite: Vorlage aus einer Datei (std::html::template_file_from)
// plus statische Dateien (std::web::static_file) aus demselben Wurzelordner.
// "/" rendert die Vorlage, alles andere wird statisch ausgeliefert; der
// Wurzelordner wird beim Start erzeugt und am Ende entfernt.
use std::html;
use std::json;
use std::web;
use std::http;
use std::net;
use std::fs;

fn ok_int(r: Result<int, string>) -> int {
    return match r {
        Result::Ok(v) => v,
        Result::Err(e) => -1
    };
}

fn write_demo_file(path: string, text: string) -> void {
    match fs::write_text(path, text) {
        Result::Ok(_) => println("Datei: " + path),
        Result::Err(e) => println("FEHLER: " + e)
    };
}

fn setup(dir: string) -> void {
    match fs::create_dir_all(fs::join_path(dir, "templates")) {
        Result::Ok(_) => println("Vorlagenordner bereit"),
        Result::Err(e) => println("FEHLER: " + e)
    };
    write_demo_file(
        fs::join_path(dir, "templates/page.html"),
        "<!doctype html><html><head><title>{{title}}</title>" +
        "<link rel=\"stylesheet\" href=\"/style.css\"></head>" +
        "<body><h1>{{title}}</h1><p>{{message}}</p></body></html>"
    );
    write_demo_file(fs::join_path(dir, "style.css"), "h1 { color: #245; }");
    write_demo_file(fs::join_path(dir, "app.js"), "console.log('seite geladen');");
}

fn cleanup(dir: string) -> void {
    fs::remove_file(fs::join_path(dir, "templates/page.html"));
    fs::remove_file(fs::join_path(dir, "style.css"));
    fs::remove_file(fs::join_path(dir, "app.js"));
    fs::remove_dir(fs::join_path(dir, "templates"));
    fs::remove_dir(dir);
}

fn page_data() -> json::JsonValue {
    let data = json::make_object();
    json::set(data, "title", json::make_string("Bloom-Website"));
    json::set(data, "message", json::make_string("Vorlage aus Datei, Dateien aus demselben Ordner."));
    return data;
}

fn render_page(conn: int, t: html::Template) -> void {
    match html::render_page_with(conn, 200, t, page_data(), "X-Content-Type-Options: nosniff") {
        Result::Ok(_) => println("Seite gesendet"),
        Result::Err(e) => println("Renderfehler: " + e)
    };
}

fn send_error(conn: int, e: string) -> void {
    println("Vorlagenfehler: " + e);
    match http::write_response_full(conn, 500, "text/plain; charset=utf-8", "", "template error") {
        Result::Ok(_) => println("Fehler gesendet"),
        Result::Err(_) => println("Schreibfehler")
    };
}

fn render_root(conn: int) -> void {
    match html::template_file_from("bloom_site_demo", "templates/page.html") {
        Result::Ok(t) => render_page(conn, t),
        Result::Err(e) => send_error(conn, e)
    };
}

fn serve_static(conn: int, request: http::HttpRequest) -> void {
    match web::static_file(conn, "bloom_site_demo", request) {
        Result::Ok(status) => println("statisch: " + str(status)),
        Result::Err(e) => println("Schreibfehler: " + e)
    };
}

fn serve(conn: int, request: http::HttpRequest) -> void {
    if request.target == "/" {
        render_root(conn);
    } else {
        serve_static(conn, request);
    }
    net::tcp_close(conn);
}

fn read_failed(conn: int, e: string) -> void {
    println("Lesefehler: " + e);
    net::tcp_close(conn);
}

fn handle(conn: int) -> void {
    match http::read_request(conn) {
        Result::Ok(request) => serve(conn, request),
        Result::Err(e) => read_failed(conn, e)
    };
}

fn accept_next(listener: int) -> void {
    match net::tcp_accept(listener) {
        Result::Ok(conn) => handle(conn),
        Result::Err(e) => println("accept: " + e)
    };
}

fn main() -> int {
    let dir = "bloom_site_demo";
    setup(dir);
    let listener = ok_int(net::tcp_listen("127.0.0.1", 0, 8));
    if listener < 0 {
        println("listen fehlgeschlagen");
        cleanup(dir);
        return 1;
    }
    println(ok_int(net::local_port(listener)));
    println("Seite: http://127.0.0.1:" + str(ok_int(net::local_port(listener))) + "/");
    var i = 0;
    while i < 10 {
        accept_next(listener);
        i = i + 1;
    }
    net::tcp_close(listener);
    cleanup(dir);
    return 0;
}
