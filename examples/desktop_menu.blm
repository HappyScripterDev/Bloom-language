// Menue: Menueleiste mit Eintraegen, Trennlinie und deaktiviertem Eintrag.
use std::desktop;

fn on_event(win: desktop::Window, ev: desktop::Event, status: int) -> bool {
    if ev.kind == "menu" {
        println("Menue: " + ev.text);
        set(win, status, "Menue: " + ev.text);
        if ev.text == "Ende" {
            match desktop::window_close(win) {
                Result::Ok(_) => println("Menue-Ende"),
                Result::Err(e) => println("Schliessen: " + e)
            };
        }
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn set(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn step(win: desktop::Window, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: Menue", 480, 220)?;
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 16)?;
    let info = desktop::label_create(win, "Datei-Menue oeffnen.", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, info, desktop::LayoutItem {
        flex: 0, width: 0, height: 28, align: ""
    })?;
    let status = desktop::label_create(win, "", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, status, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: "start"
    })?;
    desktop::layout_attach(win, root)?;
    desktop::menu_create(win)?;
    let file = desktop::menu_add(win, "Datei")?;
    desktop::menu_item(win, file, "Neu")?;
    desktop::menu_separator(win, file)?;
    desktop::menu_item(win, file, "Ende")?;
    let edit = desktop::menu_add(win, "Bearbeiten")?;
    let disabled = desktop::menu_item(win, edit, "Deaktiviert")?;
    desktop::menu_set_enabled(win, disabled, false)?;
    desktop::menu_item(win, edit, "Aktivieren")?;
    desktop::window_show(win)?;
    while step(win, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
