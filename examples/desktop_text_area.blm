// Mehrzeiliges Textfeld: Zeilenenden bleiben erhalten,
// der Button zaehlt die Zeilen.
use std::desktop;

fn on_event(win: desktop::Window, ev: desktop::Event, area: int, status: int) -> bool {
    if ev.kind == "click" {
        count(win, area, status);
    } else if ev.kind == "close" {
        println("Fenster geschlossen");
    }
    return true;
}

fn count(win: desktop::Window, area: int, status: int) -> void {
    match desktop::control_text(win, area) {
        Result::Ok(text) => show(win, status, "Zeilen: " + str(len(split(text, "\n")))),
        Result::Err(e) => println("Text: " + e)
    };
}

fn show(win: desktop::Window, label: int, text: string) -> void {
    match desktop::control_set_text(win, label, text) {
        Result::Ok(_) => println(text),
        Result::Err(e) => println("Label: " + e)
    };
}

fn step(win: desktop::Window, area: int, status: int) -> bool {
    return match desktop::next_event(win) {
        Result::Ok(ev) => on_event(win, ev, area, status),
        Result::Err(e) => fail(e)
    };
}

fn fail(e: string) -> bool {
    println("FEHLER: " + e);
    return false;
}

fn build(win: desktop::Window) -> Result<int, string> {
    let root = desktop::layout_create(win, "column")?;
    desktop::layout_set_padding(win, root, 16)?;
    desktop::layout_set_spacing(win, root, 10)?;
    let title = desktop::label_create(win, "Notizen (mehrzeilig)", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, title, desktop::LayoutItem {
        flex: 0, width: 0, height: 24, align: ""
    })?;
    let area = desktop::text_area_create(win, "Zeile eins\nZeile zwei", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, area, desktop::LayoutItem {
        flex: 1, width: 0, height: 0, align: ""
    })?;
    let button = desktop::button_create(win, "Zeilen zaehlen", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, button, desktop::LayoutItem {
        flex: 0, width: 0, height: 34, align: ""
    })?;
    let status = desktop::label_create(win, "", 0, 0, 10, 10)?;
    desktop::layout_add_control(win, root, status, desktop::LayoutItem {
        flex: 0, width: 0, height: 24, align: ""
    })?;
    desktop::layout_attach(win, root)?;
    return Result::Ok(status);
}

fn run() -> Result<int, string> {
    let win = desktop::window_create("Bloom Desktop: TextArea", 480, 340)?;
    let status = build(win)?;
    desktop::window_show(win)?;
    while step(win, 101, status) {
        if !desktop::window_alive(win) {
            break;
        }
    }
    return Result::Ok(0);
}

fn main() -> int {
    return match run() {
        Result::Ok(code) => code,
        Result::Err(e) => fehler(e)
    };
}

fn fehler(e: string) -> int {
    println("FEHLER: " + e);
    return 1;
}
